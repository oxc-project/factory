{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "oxc-factory",
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_date": "2026-11-16",
	"compatibility_flags": ["nodejs_compat"],
	"secrets": {
		"required": [
			"GITHUB_APP_ID",
			"GITHUB_APP_PRIVATE_KEY",
			"GITHUB_WEBHOOK_SECRET",
			"FACTORY_AI_GATEWAY_TOKEN",
			"FACTORY_AI_GATEWAY_ACCOUNT_ID",
			"FACTORY_AI_GATEWAY_ID"
		]
	},
	"worker_loaders": [{ "binding": "LOADER" }],
	"r2_buckets": [
		{
			"binding": "PRIVATE_REPORTS",
			"bucket_name": "oxc-factory-private-reports"
		},
		{
			"binding": "ADVERSARY_ARTIFACTS",
			"bucket_name": "oxc-factory-adversary-artifacts"
		}
	],
	"vars": {
		"SANDBOX_TRANSPORT": "rpc",
		"FACTORY_REPOSITORY": "oxc-project/oxc"
	},
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			"max_instances": 10,
			"instance_type": "standard-2"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REVIEW_COORDINATOR",
				"class_name": "ReviewCoordinator"
			},
			{
				"name": "ADVERSARY_COORDINATOR",
				"class_name": "AdversaryCoordinator"
			},
			{
				"name": "ADVERSARY_SANDBOX",
				"class_name": "Sandbox"
			},
			{
				"name": "TRIAGE_COORDINATOR",
				"class_name": "TriageCoordinator"
			},
			{
				"name": "TRIAGE_SANDBOX",
				"class_name": "Sandbox"
			},
			{
				"name": "AUTHOR_COORDINATOR",
				"class_name": "AuthorCoordinator"
			},
			{
				"name": "RELEASE_SECURITY_COORDINATOR",
				"class_name": "ReleaseSecurityCoordinator"
			},
			{
				"name": "RELEASE_SECURITY_SANDBOX",
				"class_name": "Sandbox"
			},
			{
				"name": "ADVISORY_COORDINATOR",
				"class_name": "AdvisoryCoordinator"
			},
			{
				"name": "PR_SAFETY_COORDINATOR",
				"class_name": "PrSafetyCoordinator"
			},
			{
				"name": "PR_SAFETY_SANDBOX",
				"class_name": "Sandbox"
			},
			{
				"name": "MERGE_RISK_COORDINATOR",
				"class_name": "MergeRiskCoordinator"
			}
		]
	},
	"workflows": [
		{
			"name": "oxc-factory-review",
			"binding": "REVIEW_WORKFLOW",
			"class_name": "ReviewWorkflow"
		},
		{
			"name": "oxc-factory-adversary",
			"binding": "ADVERSARY_WORKFLOW",
			"class_name": "AdversaryWorkflow"
		},
		{
			"name": "oxc-factory-triage",
			"binding": "TRIAGE_WORKFLOW",
			"class_name": "TriageWorkflow"
		},
		{
			"name": "oxc-factory-author",
			"binding": "AUTHOR_WORKFLOW",
			"class_name": "AuthorWorkflow"
		},
		{
			"name": "oxc-factory-release-security",
			"binding": "RELEASE_SECURITY_WORKFLOW",
			"class_name": "ReleaseSecurityWorkflow"
		},
		{
			"name": "oxc-factory-advisory",
			"binding": "ADVISORY_WORKFLOW",
			"class_name": "AdvisoryWorkflow"
		},
		{
			"name": "oxc-factory-pr-safety",
			"binding": "PR_SAFETY_WORKFLOW",
			"class_name": "PrSafetyWorkflow"
		},
		{
			"name": "oxc-factory-merge-risk",
			"binding": "MERGE_RISK_WORKFLOW",
			"class_name": "MergeRiskWorkflow"
		}
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		},
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"FluePullRequestReviewerAgent",
				"FlueFixVerifierAgent",
				"FlueRetriageJudgeAgent",
				"ReviewCoordinator",
				"TriageCoordinator"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["FlueTriagePipelineAgent", "Sandbox"]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"FlueReleaseSecurityReviewerAgent",
				"ReleaseSecurityCoordinator"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"FlueBlueTeamAgent",
				"FluePurpleTeamAgent",
				"AdversaryCoordinator"
			]
		},
		{
			"tag": "v5",
			"new_sqlite_classes": ["FlueCodeAuthorAgent", "AuthorCoordinator"]
		},
		{
			"tag": "v6",
			"new_sqlite_classes": ["FlueAdvisoryTriagerAgent", "AdvisoryCoordinator"]
		},
		{
			"tag": "v7",
			"new_sqlite_classes": [
				"FlueDiscordAssistantAgent",
				"DiscordGateway",
				"DiscordThreadCoordinator"
			]
		},
		{
			"tag": "v8",
			"deleted_classes": [
				"FlueDiscordAssistantAgent",
				"DiscordGateway",
				"DiscordThreadCoordinator"
			]
		},
		{
			"tag": "v9",
			"new_sqlite_classes": ["FluePrSafetyReviewerAgent", "PrSafetyCoordinator"]
		},
		{
			"tag": "v10",
			"new_sqlite_classes": [
				"FlueMergeRiskAssessorAgent",
				"MergeRiskCoordinator"
			]
		}
	]
}
